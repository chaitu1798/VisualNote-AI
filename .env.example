# ==============================================================================
# VisualNote AI — Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME="VisualNote AI"
ENVIRONMENT=development
API_V1_STR=/api/v1
PORT=8000

# Database Configuration (PostgreSQL 15)
# Use psycopg 3 adapter: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://visualnote:visualnote@localhost:5432/visualnote

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
# Generate a strong 32+ char key in production (e.g., openssl rand -hex 32)
AUTH_SECRET=change-this-to-a-secure-secret-key-in-development-12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or single URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Service Configuration
# Supported providers: 'local', 's3'
STORAGE_PROVIDER=local
STORAGE_BUCKET=visualnote
STORAGE_LOCAL_DIR=storage

# AI & Pipeline Configuration (Phase 1)
# Set MOCK_AI=true to run completely locally without external API keys
MOCK_AI=true
AI_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
MAX_UPLOAD_SIZE_MB=100
DEFAULT_THEME=clean_handwritten
# BROWSER_EXECUTABLE_PATH=  # e.g., C:\Program Files\Google\Chrome\Application\chrome.exe
